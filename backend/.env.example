# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/host_light_food

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys - LongCat（美团龙猫）
LONGCAT_API_KEY=your-longcat-api-key
LONGCAT_BASE_URL=https://api.longcat.chat/v1

# LLM API Keys - 智谱 GLM
ZHIPU_API_KEY=your-zhipu-key

# 默认模型设置
DEFAULT_LLM_MODEL=longcat-chat
LLM_TEMPERATURE=0.7

# App Settings
APP_NAME=HOST轻食多Agent框架
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080